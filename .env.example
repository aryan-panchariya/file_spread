# Create a private .env file beside this one and add your real values there.
# Never commit .env or share your BOT_TOKEN.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to administer the bot.
# This will be used in Phase 2.
ADMIN_IDS=

# Reserved for the database phase. SQLite will be the default local option.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Reserved for the delivery phase. The intended default is 20 minutes.
AUTO_DELETE_MINUTES=20

# Reserved for the force-subscription phase. Keep false during basic local tests.
FORCE_SUBSCRIPTION_ENABLED=false
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_USERNAME=
