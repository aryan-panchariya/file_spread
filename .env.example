# Create a private .env file beside this one and add your real values there.
# Never commit .env or share your BOT_TOKEN.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to administer the bot.
# Required in Phase 2. The bot will refuse to start without at least one ID.
ADMIN_IDS=

# Phase 2 stores metadata in this local SQLite database. Do not put secrets here.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# User-facing copies are deleted after this many minutes. Use 1 for local testing.
AUTO_DELETE_MINUTES=20

# Keep false to disable the membership gate during local testing.
FORCE_SUBSCRIPTION_ENABLED=false
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_USERNAME=

# Optional local link shortening. Keep disabled unless you have a VPLINK token.
VPLINK_API_TOKEN=
VPLINK_ENABLED=false
